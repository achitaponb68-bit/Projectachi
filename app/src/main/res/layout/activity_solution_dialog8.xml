<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0814"
    android:fillViewport="true"
    tools:context=".SolutionDialog8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Codie Quest"
                    tools:ignore="HardcodedText"
                    android:textColor="#38BDF8"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SQL · Prepared Statement (ด่าน 2)"
                    tools:ignore="HardcodedText"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#1B2E28"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="✔ SOLUTION 8"
                tools:ignore="HardcodedText"
                android:textColor="#4ADE80"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Title Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="— เฉลยโจทย์คำถาม"
            tools:ignore="HardcodedText"
            android:textColor="#FACC15"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Prepared Statement"
            tools:ignore="HardcodedText"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="เติมคำสั่งการใช้ Prepared Statement (Parameterized Query) เพื่อป้องกันการโจมตีประเภท SQL Injection ในขั้นตอนการตรวจสอบการเข้าสู่ระบบ"
            tools:ignore="HardcodedText"
            android:textColor="#94A3B8"
            android:textSize="13sp" />

        <!-- Complete Java Code Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#131127"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💻 โค้ดที่ถูกต้องสมบูรณ์"
                    tools:ignore="HardcodedText"
                    android:textColor="#818CF8"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Code Block -->
                <TextView
                    android:id="@+id/tvSolutionCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="#090710"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="4dp"
                    android:padding="14dp"
                    android:text="-- สร้างคำสั่งที่ปลอดภัยสำหรับการตรวจสอบการเข้าสู่ระบบ\nPREPARE login_stmt FROM\n\n'SELECT role, username FROM customer WHERE email = ? AND password_hash = ?';\n\n\n-- รับค่าที่ได้จากผู้ใช้มาเก็บไว้ในตัวแปร\nSET @user_email = 'user@example.com';\nSET @user_pass = 'hashed_pass_value';\n\n\n-- เรียกใช้คำสั่งโดยส่งค่าตัวแปรเข้าไป\nEXECUTE login_stmt USING @user_email, @user_pass;"
                    tools:ignore="HardcodedText"
                    android:textColor="#38BDF8"
                    android:textSize="13sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Explanations Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#131127"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💡 คำอธิบายเฉลยแต่ละช่อง"
                    tools:ignore="HardcodedText"
                    android:textColor="#FACC15"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- Blank 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="#1C1A36"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ช่องที่ 1:  ?"
                        tools:ignore="HardcodedText"
                        android:textColor="#4ADE80"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="ใช้เครื่องหมาย ? (Placeholder) ซ่อนค่าอินพุตจริงในโครงสร้าง SQL เพื่อป้องกันไม่ให้ผู้โจมตีฉีดคำสั่งแปลกปลอมเข้ามาได้"
                        tools:ignore="HardcodedText"
                        android:textColor="#CBD5E1"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Blank 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="#1C1A36"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ช่องที่ 2:  ?"
                        tools:ignore="HardcodedText"
                        android:textColor="#4ADE80"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="ใช้ Placeholder แทนค่า password_hash ใน Parameterized Query เช่นเดียวกัน"
                        tools:ignore="HardcodedText"
                        android:textColor="#CBD5E1"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Blank 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="#1C1A36"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ช่องที่ 3:  @user_email, @user_pass"
                        tools:ignore="HardcodedText"
                        android:textColor="#4ADE80"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="ในคำสั่ง EXECUTE ต้องใช้ USING และส่งค่าจากตัวแปรเข้าไปแทนที่เครื่องหมาย ? ตามลำดับอย่างปลอดภัย"
                        tools:ignore="HardcodedText"
                        android:textColor="#CBD5E1"
                        android:textSize="13sp" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Navigation Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnBackCategory"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:paddingVertical="12dp"
                android:text="← กลับเมนู"
                tools:ignore="HardcodedText"
                android:textColor="#FFFFFF"
                app:strokeColor="#334155" />

            <Button
                android:id="@+id/btnDone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="#0EA5E9"
                android:paddingVertical="12dp"
                android:text="เข้าใจแล้ว ➔"
                tools:ignore="HardcodedText"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>