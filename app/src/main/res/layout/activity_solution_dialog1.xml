<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0814"
    android:fillViewport="true"
    tools:context=".SolutionDialog1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Codie Quest"
                    android:textColor="#38BDF8"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ภาษา C — ระดับง่าย (Easy)"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#1B2E28"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="✔ SOLUTION"
                android:textColor="#4ADE80"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- หัวข้อเฉลย -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="— เฉลยวิธีทำ"
            android:textColor="#4ADE80"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="การตรวจสอบรหัสผ่าน"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- โค้ดฉบับสมบูรณ์ -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#131127"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💻 โค้ดฉบับสมบูรณ์"
                    android:textColor="#818CF8"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCodeSolution"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="#090710"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="4dp"
                    android:padding="14dp"
                    android:text="#include &lt;stdio.h&gt;\n#include &lt;string.h&gt;\n\nint main() {\n    char pass[] = &quot;Admin@123&quot;;\n    int len = strlen(pass);\n    int has_at = 0;\n\n    for (int i = 0; i &lt; len; i++) {\n        if (pass[i] == '@') {\n            has_at = 1; // [ช่องที่ 1]\n        }\n    }\n\n    if (len &gt;= 8 &amp;&amp; has_at == 1) { // [ช่องที่ 2]\n        printf(&quot;Strong Password\\n&quot;);\n    } else {\n        printf(&quot;Weak Password\\n&quot;); // [ช่องที่ 3]\n    }\n\n    return 0;\n}"
                    android:textColor="#38BDF8"
                    android:textSize="13sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- คำอธิบายเฉลยแต่ละช่อง -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#131127"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💡 คำอธิบายแต่ละช่อง"
                    android:textColor="#FACC15"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- ช่องที่ 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="#1C1A36"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ช่องที่ 1: has_at = 1;"
                        android:textColor="#4ADE80"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="เมื่อพบอักขระ '@' ให้ตั้งค่าตัวแปร flag (has_at = 1) ว่าพบอักขระพิเศษเรียบร้อยแล้ว"
                        android:textColor="#CBD5E1"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- ช่องที่ 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="#1C1A36"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ช่องที่ 2: len &gt;= 8 &amp;&amp; has_at == 1"
                        android:textColor="#4ADE80"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="เงื่อนไขตรวจสอบว่าต้องมีความยาวอย่างน้อย 8 ตัวอักษร (len &gt;= 8) และต้องมีตัวอักษร '@' (has_at == 1)"
                        android:textColor="#CBD5E1"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- ช่องที่ 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="#1C1A36"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ช่องที่ 3: printf(&quot;Weak Password\n&quot;);"
                        android:textColor="#4ADE80"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="หากไม่ผ่านเงื่อนไขใน if ให้แสดงข้อความว่า Weak Password"
                        android:textColor="#CBD5E1"
                        android:textSize="13sp" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Navigation Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnBackMenu"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="← กลับเมนู"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnNextQuestion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="#0EA5E9"
                android:text="ข้อถัดไป ➔"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>