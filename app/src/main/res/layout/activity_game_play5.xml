<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0E17"
    android:fillViewport="true"
    tools:context=".GamePlay5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header Navigation Bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- ปุ่มย้อนกลับ -->
            <Button
                android:id="@+id/btnBackCategory"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="0dp"
                android:text="← เลือกหมวดหมู่"
                android:textColor="#38BDF8"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="18dp"
                app:strokeColor="#1E293B"
                app:strokeWidth="1dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:text="CODIE QUEST"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Main Gameplay Card Container -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#131127"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Language & Stage Badges Bar -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- Pill Badge: Java -->
                    <TextView
                        android:id="@+id/tvLanguageBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:background="#0D3338"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:text="Java"
                        android:textColor="#22D3EE"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <!-- Stage & Question Number Badges -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvStageNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:background="#1E293B"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="ด่านที่ 2"
                            android:textColor="#E2E8F0"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvQuestionNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="#1E293B"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="ข้อ 2/3"
                            android:textColor="#E2E8F0"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </RelativeLayout>

                <!-- Title & Subtitle -->
                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Java · อาร์เรย์และลูป"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSubTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="เติมคำสั่งเพื่อป้องกันปัญหา Timing Attack ในขั้นตอนการเปรียบเทียบ Signature/Hash โดยใช้ฟังก์ชันเปรียบเทียบเวลาคงที่ (Constant-time comparison)"
                    android:textColor="#94A3B8"
                    android:textSize="13sp" />

                <!-- Divider Line -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="14dp"
                    android:background="#1E293B" />

                <!-- Question Prompt -->
                <TextView
                    android:id="@+id/tvQuestionHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="โจทย์"
                    android:textColor="#38BDF8"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvQuestionDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:text="เติมคำสั่งเพื่อป้องกันปัญหา Timing Attack ในขั้นตอนการเปรียบเทียบ Signature/Hash โดยใช้ฟังก์ชันเปรียบเทียบเวลาคงที่ (Constant-time comparison)"
                    android:textColor="#E2E8F0"
                    android:textSize="13sp" />

                <!-- CODE EDITOR Section Header -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.05"
                        android:text="CODE EDITOR"
                        android:textColor="#C084FC"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:fontFamily="monospace"
                        android:text="main.c"
                        android:textColor="#64748B"
                        android:textSize="11sp" />
                </RelativeLayout>

                <!-- Code Box Container -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardQuestion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:cardBackgroundColor="#090D16"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">

                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tvQuestionCode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:lineSpacingExtra="4dp"
                            android:text="import java.security.MessageDigest;\n\npublic class SignatureCheck {\n    public static boolean verify(byte[] expectedSig, byte[] inputSig) {\n        // ป้องกัน Side-Channel Timing Attack\n\n        boolean isValid = [ ช่องที่ 1 ].[ ช่องที่ 2 ](expectedSig, [ ช่องที่ 3 ]);\n\n        return isValid;\n    }\n}"
                            android:textColor="#38BDF8"
                            android:textSize="12sp" />
                    </ScrollView>
                </androidx.cardview.widget.CardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="เลือกช่องว่างในโค้ดก่อน แล้วเลือกคำสั่งที่ต้องการด้านล่าง"
                    android:textColor="#64748B"
                    android:textSize="11sp" />

                <!-- คำสั่งที่เลือกได้ Header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="คำสั่งที่เลือกได้"
                    android:textColor="#C084FC"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Grid Options: 2 Columns x 3 Rows -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical">

                    <!-- Row 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnOption1"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="3dp"
                            android:layout_weight="1"
                            android:backgroundTint="#0F172A"
                            android:fontFamily="monospace"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="10dp"
                            android:text="MessageDigest"
                            android:textAllCaps="false"
                            android:textColor="#E2E8F0"
                            android:textSize="11sp"
                            app:cornerRadius="8dp"
                            app:strokeColor="#1E293B"
                            app:strokeWidth="1dp" />

                        <Button
                            android:id="@+id/btnOption2"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="3dp"
                            android:layout_weight="1"
                            android:backgroundTint="#0F172A"
                            android:fontFamily="monospace"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="10dp"
                            android:text="isEqual"
                            android:textAllCaps="false"
                            android:textColor="#E2E8F0"
                            android:textSize="11sp"
                            app:cornerRadius="8dp"
                            app:strokeColor="#1E293B"
                            app:strokeWidth="1dp" />
                    </LinearLayout>

                    <!-- Row 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnOption3"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="3dp"
                            android:layout_weight="1"
                            android:backgroundTint="#0F172A"
                            android:fontFamily="monospace"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="10dp"
                            android:text="equals"
                            android:textAllCaps="false"
                            android:textColor="#E2E8F0"
                            android:textSize="11sp"
                            app:cornerRadius="8dp"
                            app:strokeColor="#1E293B"
                            app:strokeWidth="1dp" />

                        <Button
                            android:id="@+id/btnOption4"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="3dp"
                            android:layout_weight="1"
                            android:backgroundTint="#0F172A"
                            android:fontFamily="monospace"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="10dp"
                            android:text="inputSig"
                            android:textAllCaps="false"
                            android:textColor="#E2E8F0"
                            android:textSize="11sp"
                            app:cornerRadius="8dp"
                            app:strokeColor="#1E293B"
                            app:strokeWidth="1dp" />
                    </LinearLayout>

                    <!-- Row 3 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnOption5"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="3dp"
                            android:layout_weight="1"
                            android:backgroundTint="#0F172A"
                            android:fontFamily="monospace"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="10dp"
                            android:text="Arrays"
                            android:textAllCaps="false"
                            android:textColor="#E2E8F0"
                            android:textSize="11sp"
                            app:cornerRadius="8dp"
                            app:strokeColor="#1E293B"
                            app:strokeWidth="1dp" />

                        <Button
                            android:id="@+id/btnOption6"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="3dp"
                            android:layout_weight="1"
                            android:backgroundTint="#0F172A"
                            android:fontFamily="monospace"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="10dp"
                            android:text="expectedSig"
                            android:textAllCaps="false"
                            android:textColor="#E2E8F0"
                            android:textSize="11sp"
                            app:cornerRadius="8dp"
                            app:strokeColor="#1E293B"
                            app:strokeWidth="1dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Bottom Action Buttons Bar -->
                <LinearLayout
                    android:id="@+id/layoutActionButtons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <!-- ปุ่มตรวจคำตอบ -->
                    <Button
                        android:id="@+id/btnCheck"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1.2"
                        android:backgroundTint="#22D3EE"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingHorizontal="4dp"
                        android:text="✔ ตรวจคำตอบ"
                        android:textAllCaps="false"
                        android:textColor="#0F172A"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:cornerRadius="10dp" />

                    <!-- ปุ่มคำใบ้ -->
                    <Button
                        android:id="@+id/btnHint"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:layout_weight="0.9"
                        android:backgroundTint="#0F172A"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingHorizontal="4dp"
                        android:text="💡 คำใบ้"
                        android:textAllCaps="false"
                        android:textColor="#E2E8F0"
                        android:textSize="12sp"
                        app:cornerRadius="10dp"
                        app:strokeColor="#334155"
                        app:strokeWidth="1dp" />

                    <!-- ปุ่มข้อถัดไป -->
                    <Button
                        android:id="@+id/btnNext"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1.1"
                        android:backgroundTint="#A855F7"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingHorizontal="4dp"
                        android:text="ข้อถัดไป ➔"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:cornerRadius="10dp" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>