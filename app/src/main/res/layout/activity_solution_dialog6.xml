<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0814"
    android:fillViewport="true"
    tools:context=".SolutionDialog6">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Codie Quest"
                    android:textColor="#38BDF8"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Java · ป้องกัน XXE (ด่าน 3)"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#1B2E28"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="✔ SOLUTION 6"
                android:textColor="#4ADE80"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Title Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="— เฉลยโจทย์คำถาม"
            android:textColor="#FACC15"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="XML External Entity (XXE)"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="เติมคำสั่งเพื่อป้องกันช่องโหว่ XML External Entity (XXE) Injection โดยปิดการทำงานของ External DTDs และ Entities ก่อนทำการ Parse ไฟล์"
            android:textColor="#94A3B8"
            android:textSize="13sp" />

        <!-- Complete Java Code Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#131127"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💻 โค้ดที่ถูกต้องสมบูรณ์"
                    android:textColor="#818CF8"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Code Block -->
                <TextView
                    android:id="@+id/tvSolutionCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="#090710"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="4dp"
                    android:padding="14dp"
                    android:text="import javax.xml.parsers.DocumentBuilderFactory;\n\npublic class SafeXmlParser {\n    public static void secureParser(DocumentBuilderFactory dbf) throws Exception {\n        // ป้องกัน XXE โดยปิดการทำงานที่ไม่ปลอดภัย\n\n        dbf.setFeature(&quot;http://apache.org/xml/features/disallow-doctype-decl&quot;, true);\n\n        dbf.setFeature(&quot;http://xml.org/sax/features/external-general-entities&quot;, false);\n\n        dbf.setFeature(&quot;http://xml.org/sax/features/external-parameter-entities&quot;, false);\n    }\n}"
                    android:textColor="#38BDF8"
                    android:textSize="13sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Explanations Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#131127"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💡 คำอธิบายเฉลยแต่ละช่อง"
                    android:textColor="#FACC15"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- Blank 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="#1C1A36"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ช่องที่ 1:  disallow-doctype-decl"
                        android:textColor="#4ADE80"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="ต้องเปิดเป็น `true` เพื่อปิดการใช้งาน DOCTYPE เป็นการป้องกันไม่ให้ผู้โจมตีสามารถแทรกการทำงานของเอนทิตี้ที่เรียกดูไฟล์ในระบบได้"
                        android:textColor="#CBD5E1"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Blank 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="#1C1A36"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ช่องที่ 2:  false (general-entities)"
                        android:textColor="#4ADE80"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="ต้องกำหนดค่าให้คุณสมบัติ `external-general-entities` เป็น `false` เพื่อป้องกันการอ่านไฟล์ที่เป็นข้อมูลทั่วไปในระบบ (Local File Inclusion)"
                        android:textColor="#CBD5E1"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Blank 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="#1C1A36"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ช่องที่ 3:  false (parameter-entities)"
                        android:textColor="#4ADE80"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="ต้องกำหนดค่าให้คุณสมบัติ `external-parameter-entities` เป็น `false` เพื่อป้องกันช่องโหว่แบบ Out-of-band (OOB) XXE ที่จะดึงข้อมูลผ่านคำขอเว็บภายนอก"
                        android:textColor="#CBD5E1"
                        android:textSize="13sp" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Navigation Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnBackCategory"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:paddingVertical="12dp"
                android:text="← กลับเมนู"
                android:textColor="#FFFFFF"
                app:strokeColor="#334155" />

            <Button
                android:id="@+id/btnDone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="#0EA5E9"
                android:paddingVertical="12dp"
                android:text="สรุปผล ➔"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
